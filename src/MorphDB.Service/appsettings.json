{
  "ConnectionStrings": {
    "MorphDB": "Host=localhost;Port=5432;Database=morphdb;Username=morph;Password=morph"
  },
  "//ConnectionStrings:Redis": "Optional. Set this to enable the schema cache. Left unset on purpose: a default value makes the service look configured for a Redis it does not have, which turns an optional cache into a failed health check and a cache that errors on use.",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "HotChocolate": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "MorphDB": {
    "SchemaCacheExpirationMinutes": 5,
    "AdvisoryLockTimeoutSeconds": 30,
    "MaxColumnsPerTable": 500
  },
  "Jwt": {
    "SecretKey": "MorphDB-Development-Secret-Key-Must-Be-At-Least-32-Characters-Long",
    "Issuer": "MorphDB",
    "Audience": "MorphDB",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ClockSkewMinutes": 5
  },
  "Encryption": {
    "Enabled": true,
    "MasterKey": "",
    "KeyVersion": 1,
    "Algorithm": "AES-256-GCM",
    "EncryptAllByDefault": true,
    "ExcludedColumns": ["_id", "tenant_id", "_created_at", "_updated_at", "_deleted_at"]
  },
  "AllowedHosts": "*"
}
