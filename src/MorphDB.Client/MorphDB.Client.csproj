<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageId>MorphDB.Client</PackageId>
    <Title>MorphDB .NET Client SDK</Title>
    <Description>Official .NET client SDK for MorphDB - a PostgreSQL-based dynamic schema database service</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Trim and Native AOT safe: every request and response goes through generated serialization
      metadata (MorphDBJsonContext), never reflection. This turns on the trim, AOT and single-file
      analyzers, so a reflection path added later fails the build here rather than in a host that
      trims; tests/MorphDB.Client.AotSmoke proves the whole graph by publishing and running it.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
