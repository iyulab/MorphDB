<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MorphDB.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Disable common analysis rules for test methods -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1822;CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MorphDB.Core\MorphDB.Core.csproj" />
    <ProjectReference Include="..\..\src\MorphDB.Npgsql\MorphDB.Npgsql.csproj" />
    <ProjectReference Include="..\..\src\MorphDB.Service\MorphDB.Service.csproj" />
    <ProjectReference Include="..\..\src\MorphDB.Client\MorphDB.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Moq" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- The containers the suite starts are initialised by the same script the compose files mount,
         so the service under test connects as the role a deployment uses, not as a superuser. -->
    <None Include="..\..\scripts\init.sql" Link="init.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Moq" />
  </ItemGroup>

</Project>
