<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes a MorphDB.Client consumer as a Native AOT executable and runs it. The client's analyzers
    (IsAotCompatible) see its own code at build time; only a real AOT publish sees the whole graph a
    host compiles, the SignalR client included, and only running the result proves the reflection-free
    serialization paths work. Not a test project: `dotnet test` does not run it; CI publishes and
    executes it. TreatWarningsAsErrors (Directory.Build.props) turns any trim or AOT warning the publish
    reports into a failed publish.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The AOT compiler package comes with the SDK at the runtime patch the SDK was cut with. 10.0.13 carries
    GHSA-p3jp-9v83-76w9 (Brotli decoder out-of-bounds write); raising the pack version here takes the fixed patch
    without waiting for an SDK that bundles it. Drop this once the SDK in use is at 10.0.14 or later.
  -->
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MorphDB.Client\MorphDB.Client.csproj" />
  </ItemGroup>

</Project>
